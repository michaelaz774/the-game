# ─── Supabase (optional) ──────────────────────────────────────────────────────
# When both variables are set, scores are synced to a shared Supabase table so
# the leaderboard is shared across all devices playing at the event.
# If either variable is absent the game works fully offline with a per-device
# local leaderboard — great insurance against bad expo wifi!
#
# Copy this file to .env.local and fill in your project values.
# NEVER commit .env.local — it is already in .gitignore.

# Your Supabase project URL  (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key  (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=
